AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Run an AI review automatically when a contract is submitted for approval (needs the Azure settings above)
AI_REVIEW_ON_SUBMIT=1
DATABASE_PATH=backend/data/contracts.db
# Use PostgreSQL instead of SQLite (see the README):
# DATABASE_URL=postgresql://clause:clause@127.0.0.1:5432/clause
UPLOAD_DIR=backend/data/uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sign-in
CLAUSE_SEED_PASSWORD=ChangeMe123!
# Set to 1 when the app is served over HTTPS
COOKIE_SECURE=0
SEED_DEMO_DATA=1

# Reminders
REMINDERS_ENABLED=1
REMINDER_INTERVAL_HOURS=6

# Optional email for notifications (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=clause@example.com

# E-signature: the address signers open (used in signing links) and how long links stay valid
PUBLIC_APP_URL=http://localhost:3000
SIGNING_LINK_DAYS=30

# Single sign-on with Microsoft Entra ID (leave SSO_CLIENT_ID empty to disable). See the README.
ENTRA_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTO_PROVISION=1
SSO_DEFAULT_ROLE=viewer
SSO_ALLOWED_DOMAINS=
PASSWORD_LOGIN=1
